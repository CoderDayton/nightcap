<component type="desktop-application">
  <id>io.github.CoderDayton.nightcap</id>
  <name>Nightcap</name>
  <summary>Play Roblox on Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="io.github.coderdayton">
    <name>vii</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#CEB3EF</color>
    <color type="primary" scheme_preference="dark">#2F2A6B</color>
  </branding>
  <url type="homepage">https://github.com/CoderDayton/nightcap</url>
  <description>
    <p>
      Sign in to Roblox, browse experiences, and play them on Linux.
    </p>
    <p>
      Mocktail is an independent community project. It is not affiliated with
      Roblox Corporation or VinegarHQ, and the Roblox client is not included.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-home.png</image>
      <caption>Browse Roblox experiences</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-gameplay-tower.png</image>
      <caption>Play Tower of Hell on Linux</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-gameplay-lobby.png</image>
      <caption>Play DOORS on Linux</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.CoderDayton.nightcap.desktop</launchable>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">moderate</content_attribute>
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="social-audio">moderate</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
    <content_attribute id="money-advertising">intense</content_attribute>
    <content_attribute id="money-gambling">moderate</content_attribute>
  </content_rating>
  <provides>
    <binary>mocktail</binary>
  </provides>
  <releases>
    <release version="1.0.4" date="2026-09-11">
      <description>
        <ul>
          <li>Fixed login issues</li>
          <li>Fixed low-resolution textures, skybox rendering and HiDPI scaling.</li>
          <li>Added vc support.</li>
          <li>Added Xbox and PlayStation gamepad support.</li>
          <li>Added Nix support</li>
          <li>Improved text input, fullscreen mode, window sizing, and mouse controls.</li>
          <li>Updated support for Roblox 2.736.1408.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.3" date="2026-08-16">
      <description>
        <ul>
          <li>Fixed issues with downloading Roblox on first launch</li>
          <li>Added fflags.json for custom FFlags</li>
          <li>Added a message if your cookies have expired</li>
        </ul>
      </description>
    </release>
    <release version="1.0.2" date="2026-08-14">
      <description>
        <ul>
          <li>Fixed the “Roblox is out of date” bug</li>
          <li>Improved logging</li>
          <li>Fixed issues with Discord RPC where the game you were playing wasn’t displayed</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-08-13">
      <description>
        <ul>
          <li>Fix issues with GameMode</li>
          <li>Add Discord RPC support</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-12"/>
  </releases>
</component>
