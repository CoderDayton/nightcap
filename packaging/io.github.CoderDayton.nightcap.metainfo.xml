<component type="desktop-application">
  <id>io.github.CoderDayton.nightcap</id>
  <name>Nightcap</name>
  <summary>Play Roblox on Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="io.github.coderdayton">
    <name>vii</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#CEB3EF</color>
    <color type="primary" scheme_preference="dark">#2F2A6B</color>
  </branding>
  <url type="homepage">https://github.com/CoderDayton/nightcap</url>
  <description>
    <p>
      Sign in to Roblox, browse experiences, and play them on Linux.
    </p>
    <p>
      Nightcap is an independent community project, forked from Mocktail. It
      is not affiliated with Roblox Corporation or VinegarHQ, and the Roblox
      client is not included.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-home.png</image>
      <caption>Browse Roblox experiences</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-gameplay-tower.png</image>
      <caption>Play Tower of Hell on Linux</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/komaruworld/mocktail/88b7382577aa138a2d16619b091f69abcdf7da15/assets/screenshots/flatpak-gameplay-lobby.png</image>
      <caption>Play DOORS on Linux</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.CoderDayton.nightcap.desktop</launchable>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">moderate</content_attribute>
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="social-audio">moderate</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
    <content_attribute id="money-advertising">intense</content_attribute>
    <content_attribute id="money-gambling">moderate</content_attribute>
  </content_rating>
  <provides>
    <binary>mocktail</binary>
  </provides>
  <releases>
    <release version="0.3.1" date="2026-09-20">
      <description>
        <ul>
          <li>Added DEB, RPM, and pacman packages to every release.</li>
          <li>Smoother frames: textures no longer decode on the thread that submits the frame.</li>
          <li>Fixed the mouse pointer jumping when a right-click camera drag ended.</li>
          <li>Fixed the text caret not moving when a trailing space was typed.</li>
          <li>Faster typing in text boxes.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-18">
      <description>
        <ul>
          <li>Added a custom Discord presence: set the title, state, and icons.</li>
          <li>Added --profile to record a trace of the renderer's work.</li>
          <li>Faster texture loading: compressed textures decode and resample on worker threads.</li>
          <li>Lower CPU use while playing.</li>
          <li>Fixed GameMode pinning the game to a few CPU cores.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-16">
      <description>
        <ul>
          <li>Discord Rich Presence is on by default.</li>
          <li>Added input.raw_mouse for mouse look in the host's own units.</li>
          <li>Fixed mouse look after a long turn.</li>
          <li>Fixed a first-run failure with "cannot lock appStorage".</li>
          <li>Values in fflags.json now win over the performance preset.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-15">
      <description>
        <ul>
          <li>First Nightcap release, forked from Mocktail.</li>
          <li>Added ETC2 and EAC texture emulation on Vulkan.</li>
          <li>Added PNG texture overrides.</li>
          <li>Lower input latency.</li>
          <li>Roblox now sees the real host RAM and display size.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
