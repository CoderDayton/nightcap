#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Source { uint src[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Destination { uint dst[]; };

layout(push_constant) uniform Job {
  uint format;
  uint blocks_wide;
  uint blocks_high;
  uint src_offset;
  uint src_row_blocks;
  uint src_layer_blocks;
  uint dst_offset;
  uint dst_layer_words;
} job;

#include "etc2_common.glsl"

void main() {
  uint bx = gl_GlobalInvocationID.x;
  uint by = gl_GlobalInvocationID.y;
  uint layer = gl_GlobalInvocationID.z;
  if (bx >= job.blocks_wide || by >= job.blocks_high) {
    return;
  }
  bool rg = job.format == kRg11 || job.format == kRg11Signed;
  bool wide = job.format == kRgba8 || rg;
  uint block_words = wide ? 4u : 2u;
  uint word = job.src_offset +
              (layer * job.src_layer_blocks + by * job.src_row_blocks + bx) * block_words;
  uint out_layer = job.dst_offset + layer * job.dst_layer_words;

  if (job.format <= kRgba8) {
    uint texels[16];
    DecodeColorBlock(word, job.format, texels);
    uint row_words = job.blocks_wide * 4u;
    for (uint y = 0u; y < 4u; ++y) {
      uint row = out_layer + (by * 4u + y) * row_words + bx * 4u;
      for (uint x = 0u; x < 4u; ++x) {
        dst[row + x] = texels[x * 4u + y];
      }
    }
    return;
  }

  bool is_signed = job.format == kR11Signed || job.format == kRg11Signed;
  if (rg) {
    uint row_words = job.blocks_wide * 4u;
    for (uint y = 0u; y < 4u; ++y) {
      uint row = out_layer + (by * 4u + y) * row_words + bx * 4u;
      for (uint x = 0u; x < 4u; ++x) {
        int t = int(x * 4u + y);
        uint r = EacValue(word, EacIndex(word, t), is_signed);
        uint g = EacValue(word + 2u, EacIndex(word + 2u, t), is_signed);
        dst[row + x] = r | (g << 16u);
      }
    }
    return;
  }
  uint row_words = job.blocks_wide * 2u;
  for (uint y = 0u; y < 4u; ++y) {
    uint row = out_layer + (by * 4u + y) * row_words + bx * 2u;
    for (uint x = 0u; x < 4u; x += 2u) {
      uint a = EacValue(word, EacIndex(word, int(x * 4u + y)), is_signed);
      uint b = EacValue(word, EacIndex(word, int((x + 1u) * 4u + y)), is_signed);
      dst[row + x / 2u] = a | (b << 16u);
    }
  }
}
